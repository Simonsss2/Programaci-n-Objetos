struct Nodo{
    int x;
    Nodo*sig;
};
Nodo*push_front(Nodo*cabeza,int x){
    Nodo*nuevo=(Nodo*)malloc(sizeof(Nodo));
    nuevo->x=x;nuevo->sig=cabeza;
    return nuevo;
}
Nodo*push_back(Nodo*cabeza,int x){
    Nodo*nuevo=(Nodo*)malloc(sizeof(Nodo));
    nuevo->x=x;nuevo->sig=nullptr;
    if(!cabeza)return nuevo;
    Nodo*tmp=cabeza;
    while(tmp->sig)tmp=tmp->sig;
    tmp->sig=nuevo;
    return cabeza;
}
Nodo*pop_front(Nodo*cabeza){
    if(!cabeza)return nullptr;
    Nodo*tmp=cabeza;
    cabeza=cabeza->sig;
    free(tmp);
    return cabeza;
}
void print_list(Nodo*cabeza){
    while(cabeza){
        cout<<cabeza->x<<" ";
        cabeza=cabeza->sig;
    }
    cout<<endl;
}
void clear(Nodo*cabeza){
    while(cabeza){
        Nodo*tmp=cabeza;
        cabeza=cabeza->sig;
        free(tmp);
    }
}
void ejercicio6(){
    cout<<"EJERCICIO 6: Lista dinamica simple"<<endl;
    Nodo*cabeza=nullptr;
    string cmd;
    while(true){
        cin>>cmd;
        if(cmd=="fin")break;
        if(cmd=="pf"){
            int x;cin>>x;cabeza=push_front(cabeza,x);
        }else if(cmd=="pb"){
            int x;cin>>x;cabeza=push_back(cabeza,x);
        }else if(cmd=="pop"){
            cabeza=pop_front(cabeza);
        }else if(cmd=="clear"){
            clear(cabeza);cabeza=nullptr;
        }
    }
    print_list(cabeza);
    clear(cabeza);
    cout<<endl;
}
int doble(int x){return x*2;}
int cuadrado(int x){return x*x;}

void aplicar(int*a,size_t n,int(*op)(int)){
    for(size_t i=0;i<n;i++)a[i]=op(a[i]);
}

void ejercicio7(){
