void ejercicio4(){
    cout<<"EJERCICIO 4: Matriz suma por fila y columnas"<<endl;
    int m,n;
    cout<<"Ingrese las dimensiones de la matriz (m filas, n columnas): "; cin>>m>>n;
    vector<vector<int>>A(m,vector<int>(n));
    cout<<"Ingrese los elementos:"<<endl;
    for(int i=0;i<m;i++)
        for(int j=0;j<n;j++)
            cin>>A[i][j];
    cout<<"Matriz ingresada:"<<endl;
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++)cout<<A[i][j]<<" ";
        cout<<endl;
    }
    cout<<"Suma por fila: ";
    for(int i=0;i<m;i++){
        int suma=accumulate(A[i].begin(),A[i].end(),0);
        cout<<suma<<" ";
    }
    cout<<endl<<"Suma por columna: ";
    for(int j=0;j<n;j++){
        int suma=0;
        for(int i=0;i<m;i++)suma+=A[i][j];
        cout<<suma<<" ";
    }
    cout<<endl<<endl;
}
struct Estudiante{
    char nombre[40];
    int edad;
    double promedio;
};
int cmp_prom_desc(const void*a,const void*b){
    double pa=((Estudiante*)a)->promedio;
    double pb=((Estudiante*)b)->promedio;
    return (pb>pa)-(pb<pa);
}
int buscar_nombre(Estudiante*v,size_t n,const char*clave){
    for(size_t i=0;i<n;i++){
        if(strcmp(v[i].nombre,clave)==0)
            return i;
    }
    return -1;
}
