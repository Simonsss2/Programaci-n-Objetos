struct Venta{
    char prod[32];
    int unidades;
    double precio;
};
void ejercicio8(){
    cout<<"EJERCICIO 8: Archivo + estructuras — estadisticas de ventas"<<endl;
    ifstream f("ventas.csv");
    if(!f){
        cout<<"Error: no se pudo abrir el archivo ventas.csv"<<endl;
        return;
    }
    vector<Venta>v;
    Venta tmp;
    char coma;
    while(f.getline(tmp.prod,32,',')){
        f>>tmp.unidades>>coma>>tmp.precio;
        f.ignore(1000,'\n');
        v.push_back(tmp);
    }
    double total=0;
    int maxInd=0;
    for(size_t i=0;i<v.size();i++){
        total+=v[i].unidades*v[i].precio;
        if(v[i].unidades>v[maxInd].unidades)maxInd=i;
    }
    cout<<"Total vendido: "<<fixed<<setprecision(2)<<total<<endl;
    cout<<"Producto mas vendido: "<<v[maxInd].prod<<endl;
    cout<<"Ticket promedio: "<<(total/v.size())<<endl<<endl;
}
