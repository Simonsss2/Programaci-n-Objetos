class Cuenta{
protected:
    string numeroCuenta;
    string propietario;
    double saldo;
public:
    Cuenta(){}
    Cuenta(string _numero,string _propietario,double _saldo){
        numeroCuenta = _numero;
        propietario = _propietario;
        saldo = _saldo;
    }
    virtual void depositar(double monto){
        if(monto > 0) saldo += monto;
        else cout<<"Monto invalido.\n";
    }
    virtual void retirar(double monto){
        if(monto > 0 && monto <= saldo) saldo -= monto;
        else cout<<"Fondos insuficientes o monto invalido.\n";
    }
    virtual void mostrarInfo(){
        cout<<"\nCuenta: "<<numeroCuenta<<endl;
        cout<<"Propietario: "<<propietario<<endl;
        cout<<"Saldo: $"<<saldo<<endl;
    }
    string getNumeroCuenta(){
        return numeroCuenta;
        }
    string getPropietario(){
        return propietario;
    }
    double getSaldo(){
        return saldo; 
    }
    void setSaldo(double s){
        saldo = s;
    }
};
class CuentaAhorro : public Cuenta{
private:
    double tasaInteres;
public:
    CuentaAhorro(){}
    CuentaAhorro(string num,string prop,double saldo,double interes)
        : Cuenta(num,prop,saldo){
        tasaInteres = interes;
    }
    void generarInteres(){
        double interes = saldo * tasaInteres;
        saldo += interes;
    }
    void depositar(double monto) override{
        cout << "\n[Cuenta Ahorro] Deposito con beneficio\n";
        Cuenta::depositar(monto);
    }
    void retirar(double monto) override{
        cout << "\n[Cuenta Ahorro] Retiro\n";
        Cuenta::retirar(monto);
    }
};
class CuentaCorriente : public Cuenta{
private:
    double limiteDescubierto;
public:
    CuentaCorriente(){}
    CuentaCorriente(string num,string prop,double saldo,double limite)
        : Cuenta(num,prop,saldo){
        limiteDescubierto = limite;
    }
    void solicitarDescubierto(double monto){
        if(monto <= limiteDescubierto){
            saldo -= monto;
            cout<<"Descubierto aprobado: $"<<monto<<endl;
        }else{
            cout<<"El descubierto excede el límite permitido.\n";
        }
    }
    void retirar(double monto) override{
        if(monto <= saldo + limiteDescubierto){
            saldo -= monto;
            cout<<"\n[Cuenta Corriente] Retiro con posible descubierto\n";
        }
        else{
            cout<<"No se puede retirar: supera el límite con descubierto.\n";
        }
    }
};



