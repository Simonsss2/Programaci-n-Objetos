class vehiculo{
	private:
		string marca;
		string modelo;
		int anio;
		double velocidadMax;
	public:
		vehiculo();
		void setVehiculo(string,string,int,double);
		string getVehiculoMarca();
		string getVehiculoModelo();
		int getVehiculoAnio();
		double getVehiculoVelocidadMax();
		virtual void mostrarInfo();
		void acelerar(double incremento);
};
vehiculo::vehiculo(){
}

void vehiculo::setVehiculo(string _marca,string _modelo,int _anio,double _velocidadMax){
	marca = _marca;
	modelo = _modelo;
	if(_anio > 1886)
		anio = _anio;
	else{
		cout<<"El año del vehiculo debe ser mayor a 1886.";
	}
	if(_velocidadMax > 0)
		velocidadMax = _velocidadMax;
	else{
		cout<<"La verlocidad maxima debe ser mayor a 0";
	}	
}
string vehiculo::getVehiculoMarca(){
	return marca;
}
 
string vehiculo::getVehiculoModelo(){
	return modelo;
}

int vehiculo::getVehiculoAnio(){
	return anio;
}

double vehiculo::getVehiculoVelocidadMax(){
	return velocidadMax;
}

void vehiculo::acelerar(double incremento){
	if(incremento > 0){
		velocidadMax += incremento;
		cout<<"Nueva velocidad maxima: "<<velocidadMax<<endl;
	}else{
		cout<<"El incremento debe ser positiva.\n";
	}
}

void vehiculo::mostrarInfo(){
	cout<<"\nMarca: "<<marca<<endl;
	cout<<"Modelo: "<<modelo<<endl;
	cout<<"Anio: "<<anio<<endl;
	cout<<"Velocidad Maxima: "<<velocidadMax<<endl;
}

class producto{
	private:
		string codigo;
		string nombre;
