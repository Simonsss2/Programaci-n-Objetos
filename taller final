#include<iostream>
#include<stdlib.h>
#include<string>
using namespace std;

class vehiculo{
	private:
		string marca;
		string modelo;
		int anio;
		double velocidadMax;
	public:
		vehiculo();
		void setVehiculo(string,string,int,double);
		string getVehiculoMarca();
		string getVehiculoModelo();
		int getVehiculoAnio();
		double getVehiculoVelocidadMax();
		virtual void mostrarInfo();
		void acelerar(double incremento);
};
vehiculo::vehiculo(){
}

void vehiculo::setVehiculo(string _marca,string _modelo,int _anio,double _velocidadMax){
	marca = _marca;
	modelo = _modelo;
	if(_anio > 1886)
		anio = _anio;
	else{
		cout<<"El año del vehiculo debe ser mayor a 1886.";
	}
	if(_velocidadMax > 0)
		velocidadMax = _velocidadMax;
	else{
		cout<<"La verlocidad maxima debe ser mayor a 0";
	}	
}
string vehiculo::getVehiculoMarca(){
	return marca;
}
 
string vehiculo::getVehiculoModelo(){
	return modelo;
}

int vehiculo::getVehiculoAnio(){
	return anio;
}

double vehiculo::getVehiculoVelocidadMax(){
	return velocidadMax;
}

void vehiculo::acelerar(double incremento){
	if(incremento > 0){
		velocidadMax += incremento;
		cout<<"Nueva velocidad maxima: "<<velocidadMax<<endl;
	}else{
		cout<<"El incremento debe ser positiva.\n";
	}
}

void vehiculo::mostrarInfo(){
	cout<<"\nMarca: "<<marca<<endl;
	cout<<"Modelo: "<<modelo<<endl;
	cout<<"Anio: "<<anio<<endl;
	cout<<"Velocidad Maxima: "<<velocidadMax<<endl;
}

class producto{
	private:
		string codigo;
		string nombre;
		double precio;
		int cantidad;
		double total;
	public:
		producto();
		void setproducto(string,string,double,int);
		string getProductoCodigo();
		string getProductoNombre();
		double getProductoPrecio();
		double getProductoTotal();
		int getProductoCantidad();
		void mostrarInfo();
		void calcularValorTotal();
		void aplicarDescuento(double porcentaje);		
};
producto::producto(){
}

void producto::setproducto(string _codigo,string _nombre,double _precio,int _cantidad){
	codigo = _codigo;
	nombre = _nombre;
	if(_precio > 0)
		precio = _precio;
	else{
		cout<<"El precio no puede ser negativo";
	}
	if(_cantidad > 0)
		cantidad = _cantidad;
	else{
		cout<<"La cantidad no puede ser negativa";
	}
}
string producto::getProductoCodigo(){
	return codigo;
}
string producto::getProductoNombre(){
	return nombre;
}
double producto::getProductoPrecio(){
	return precio;
}
double producto::getProductoTotal() {
    return total;
}

int producto::getProductoCantidad(){
	return cantidad;
}

void producto::mostrarInfo(){
	cout<<"\nCodigo: "<<codigo<<endl;
	cout<<"Nombre: "<<nombre<<endl;
	cout<<"Precio: "<<precio<<endl;
	cout<<"Cantidad: "<<cantidad<<endl;
}

void producto::aplicarDescuento(double porcentaje){
	if(porcentaje > 0){
		precio = precio - (precio * (porcentaje/100));
	}else{
		cout<<"El porcentaje debe ser positivo.";
	}
}

void producto::calcularValorTotal(){
	total = precio * cantidad;
}


