		int cantidad;
		double total;
	public:
		producto();
		void setproducto(string,string,double,int);
		string getProductoCodigo();
		string getProductoNombre();
		double getProductoPrecio();
		double getProductoTotal();
		int getProductoCantidad();
		void mostrarInfo();
		void calcularValorTotal();
		void aplicarDescuento(double porcentaje);		
};
producto::producto(){
}

void producto::setproducto(string _codigo,string _nombre,double _precio,int _cantidad){
	codigo = _codigo;
	nombre = _nombre;
	if(_precio > 0)
		precio = _precio;
	else{
		cout<<"El precio no puede ser negativo";
	}
	if(_cantidad > 0)
		cantidad = _cantidad;
	else{
		cout<<"La cantidad no puede ser negativa";
	}
}
string producto::getProductoCodigo(){
	return codigo;
}
string producto::getProductoNombre(){
	return nombre;
}
double producto::getProductoPrecio(){
	return precio;
}
double producto::getProductoTotal() {
    return total;
}

int producto::getProductoCantidad(){
	return cantidad;
}

void producto::mostrarInfo(){
	cout<<"\nCodigo: "<<codigo<<endl;
	cout<<"Nombre: "<<nombre<<endl;
	cout<<"Precio: "<<precio<<endl;
	cout<<"Cantidad: "<<cantidad<<endl;
}

void producto::aplicarDescuento(double porcentaje){
	if(porcentaje > 0){
		precio = precio - (precio * (porcentaje/100));
	}else{
		cout<<"El porcentaje debe ser positivo.";
	}
}

void producto::calcularValorTotal(){
	total = precio * cantidad;
}


